<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B0B">

    <ImageView
        android:id="@+id/lensImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="Selected image" />

    <com.example.notiforwarder.TextLensView
        android:id="@+id/lensOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/lensProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Top hint chip -->
    <TextView
        android:id="@+id/lensHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="72dp"
        android:background="#CC1A1A1A"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp"
        android:text="Tap or drag across text to select"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="#66000000">

        <Button
            android:id="@+id/backBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back"
            android:backgroundTint="#CC000000"
            android:textColor="#FFFFFF" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/copyAllBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Copy All"
            android:backgroundTint="#009688"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Bottom sheet -->
    <LinearLayout
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp"
        android:visibility="gone"
        android:elevation="20dp">

        <!-- Drag handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="#DDDDDD" />

        <TextView
            android:id="@+id/sheetCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="0 lines selected"
            android:textColor="#666666"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:letterSpacing="0.1" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="180dp"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/selectedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"
                android:textColor="#111111"
                android:fontFamily="monospace" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">

            <Button
                android:id="@+id/copySelBtn"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:backgroundTint="#3F51B5"
                android:textColor="#FFFFFF"
                android:text="Copy" />

            <Button
                android:id="@+id/shareSelBtn"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:backgroundTint="#009688"
                android:textColor="#FFFFFF"
                android:text="Share" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>