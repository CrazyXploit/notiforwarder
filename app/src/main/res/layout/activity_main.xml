<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:gravity="center"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Screenshot OCR"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/primary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Detects all text on your image.\nTap any highlighted line to copy it.\nJust like Google Lens."
        android:textSize="14sp"
        android:textColor="@color/textSecondary" />

    <Button
        android:id="@+id/pickBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:backgroundTint="@color/primary"
        android:textColor="#FFFFFF"
        android:paddingVertical="14dp"
        android:text="Choose Image" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="Tip: you can also share any image to this app from Gallery."
        android:textSize="12sp"
        android:textColor="@color/textSecondary" />

</LinearLayout>